# Копия -> .env. install.sh заполняет пароли сам; здесь — что можно задать вручную.
# Публичный адрес сервиса (в ссылках уведомлений)
BASE_URL=https://callqa.example.com

# Оценка звонков. По умолчанию — встроенный Ollama (install.sh --with-llm): модели выбираются в админке.
# Свой OpenAI-совместимый сервер (vLLM, LiteLLM, llama.cpp) вместо встроенного — укажите адрес.
# Внешний облачный API (OpenAI и др.) задаётся в админке «Модели», здесь ничего не нужно.
LLM_URL=
LLM_KEY=
LLM_MODEL=

# Заполняет install.sh
ADMIN_USER=admin
ADMIN_PASSWORD=
DB_PASSWORD=

# Необязательное
TG_TOKEN=
MAX_UPLOAD_MB=200
DATA_DIR=./volumes
HTTP_PORT=80
HTTPS_PORT=443
CALLQA_VERSION=0.1.0
